# Copie para .env na VPS: cp deploy/env.vps.example .env

# Domínio apontando para o IP da VPS (HTTPS automático via Caddy)
DOMAIN=mailing.seudominio.com.br
ACME_EMAIL=seu@email.com

# Django
DEBUG=False
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=mailing.seudominio.com.br
CSRF_TRUSTED_ORIGINS=https://mailing.seudominio.com.br

# Postgres (container db)
POSTGRES_DB=mailing_enderecos
POSTGRES_USER=mailing
POSTGRES_PASSWORD=troque-por-uma-senha-forte
DATABASE_URL=postgres://mailing:troque-por-uma-senha-forte@db:5432/mailing_enderecos
DATABASE_SSL_REQUIRE=false

# Google My Maps
GOOGLE_MAPS_URL=https://www.google.com/maps/d/viewer?mid=1NfQvsWBh_AmyvVABRRd7_lJ4W4mg8q4&ll=-23.281103667749008%2C-51.28276285&z=17

# Playwright (automação online)
PLAYWRIGHT_ENABLED=True
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_REQUIRE_AUTH=True
PLAYWRIGHT_BROWSER_CHANNEL=
PLAYWRIGHT_STORAGE_STATE=/app/playwright/google-auth.json

# Opção A: envie o arquivo google-auth.json para /app/playwright/ (volume Docker)
# Opção B: cole o JSON inteiro em uma linha (sem quebras):
# PLAYWRIGHT_STORAGE_STATE_JSON={"cookies":[...],"origins":[...]}
